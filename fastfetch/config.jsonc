{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": ".config/fastfetch/ascii/arch.txt",
    "width": 58,
    "height": 23,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 20
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "╭─ {#bright_yellow}{user-name}@{host-name}{#white} ──────────────────────────────────────────────────╮"
    },
    {
      "type": "os",
      "key": "│  {#blue} {#blue}OS\u001b[s\u001b[130G{#white}│\u001b[u{#blue}",
      "keyColor": "white"
    },
    {
      "type": "host",
      "key": "│  {#blue} {#blue}Host\u001b[s\u001b[130G{#white}│\u001b[u{#blue}",
      "keyColor": "white"
    },
    {
      "type": "kernel",
      "key": "│  {#blue} {#blue}Kernel\u001b[s\u001b[130G{#white}│\u001b[u{#blue}",
      "keyColor": "white"
    },
    {
      "type": "uptime",
      "key": "│  {#blue} {#blue}Uptime\u001b[s\u001b[130G{#white}│\u001b[u{#blue}",
      "keyColor": "white"
    },
    {
      "type": "shell",
      "key": "│  {#blue} {#blue}Shell\u001b[s\u001b[130G{#white}│\u001b[u{#blue}",
      "keyColor": "white"
    },
    {
      "type": "terminal",
      "key": "│  {#blue} {#blue}Terminal\u001b[s\u001b[130G{#white}│\u001b[u{#blue}",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────╯",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "╭─ {#bright_cyan}Appearance{#white} ─────────────────────────────────────────────────────╮",
      "outputColor": "white"
    },
    {
      "type": "wm",
      "key": "│  {#magenta} {#magenta}WM\u001b[s\u001b[130G{#white}│\u001b[u{#magenta}",
      "keyColor": "white"
    },
    {
      "type": "wmtheme",
      "key": "│  {#magenta} {#magenta}WM Theme\u001b[s\u001b[130G{#white}│\u001b[u{#magenta}",
      "keyColor": "white"
    },
    {
      "type": "theme",
      "key": "│  {#magenta} {#magenta}Theme\u001b[s\u001b[130G{#white}│\u001b[u{#magenta}",
      "keyColor": "white"
    },
    {
      "type": "cursor",
      "key": "│  {#magenta} {#magenta}Cursor\u001b[s\u001b[130G{#white}│\u001b[u{#magenta}",
      "keyColor": "white"
    },
    {
      "type": "terminalfont",
      "key": "│  {#magenta} {#magenta}Term Font\u001b[s\u001b[130G{#white}│\u001b[u{#magenta}",
      "keyColor": "white"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────╯",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "╭─ {#bright_red}Hardware{#white} ───────────────────────────────────────────────────────╮",
      "outputColor": "white"
    },
    {
      "type": "cpu",
      "key": "│  {#green} {#green}CPU\u001b[s\u001b[130G{#white}│\u001b[u{#green}",
      "keyColor": "white",
      "showPeCoreCount": true
    },
    {
      "type": "gpu",
      "key": "│  {#green} {#green}GPU\u001b[s\u001b[130G{#white}│\u001b[u{#green}",
      "keyColor": "white",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│  {#green} {#green}Memory\u001b[s\u001b[130G{#white}│\u001b[u{#green}",
      "keyColor": "white"
    },
    {
      "type": "swap",
      "key": "│  {#green} {#green}Swap\u001b[s\u001b[130G{#white}│\u001b[u{#green}",
      "keyColor": "white"
    },
    {
      "type": "disk",
      "key": "│  {#green} {#green}Disk\u001b[s\u001b[130G{#white}│\u001b[u{#green}",
      "keyColor": "white",
      "folders": "/"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────╯",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "╭─ {#bright_blue}Colours{#white} ────────────────────────────────────────────────────────╮",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "│  {#black}   {#red}   {#green}   {#yellow}   {#blue}   {#magenta}   {#cyan}   {#white}   {#bright_black}   {#bright_red}   {#bright_green}   {#bright_yellow}   {#bright_blue}   {#bright_magenta}   {#bright_cyan}   {#bright_white}   {#white}│",
      "outputColor": "white"
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────────────────────────────────────────╯",
      "outputColor": "white"
    },
    "break"
  ]
}
