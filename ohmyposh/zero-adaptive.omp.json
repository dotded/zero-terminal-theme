{
    "$schema":  "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks":  [
                   {
                       "alignment":  "left",
                       "segments":  [
                                        {
                                            "background":  "blue",
                                            "foreground":  "white",
                                            "leading_diamond":  "",
                                            "style":  "diamond",
                                            "template":  "ZERO ",
                                            "type":  "session"
                                        },
                                        {
                                            "background":  "magenta",
                                            "foreground":  "white",
                                            "powerline_symbol":  "",
                                            "options":  {
                                                            "style":  "folder"
                                                        },
                                            "style":  "powerline",
                                            "template":  " {{ .Path }} ",
                                            "type":  "path"
                                        },
                                        {
                                            "background":  "yellow",
                                            "foreground":  "black",
                                            "powerline_symbol":  "",
                                            "options":  {
                                                            "branch_icon":  ""
                                                        },
                                            "style":  "powerline",
                                            "template":  "  ({{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }}) ",
                                            "type":  "git"
                                        },
                                        {
                                            "background":  "cyan",
                                            "foreground":  "black",
                                            "powerline_symbol":  "",
                                            "style":  "powerline",
                                            "template":  "  {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
                                            "type":  "node"
                                        },
                                        {
                                            "background":  "red",
                                            "foreground":  "white",
                                            "options":  {
                                                            "time_format":  "15:04"
                                                        },
                                            "style":  "diamond",
                                            "template":  " ♥ {{ .CurrentDate | date .Format }} ",
                                            "trailing_diamond":  "",
                                            "type":  "time"
                                        }
                                    ],
                       "type":  "prompt"
                   },
                   {
                       "alignment":  "left",
                       "segments":  [
                                        {
                                            "background":  "yellow",
                                            "foreground":  "black",
                                            "invert_powerline":  true,
                                            "leading_diamond":  "",
                                            "style":  "diamond",
                                            "template":  "  {{.Profile}}{{if .Region}}@{{.Region}}{{end}}",
                                            "trailing_diamond":  "",
                                            "type":  "aws"
                                        }
                                    ],
                       "type":  "rprompt"
                   }
               ],
    "final_space":  true,
    "version":  4
}